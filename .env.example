# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=hydropi_user
DB_PASSWORD=change_me_strong_password
DB_NAME=hydropidb

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_FROM=your.email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_TO=destination@email.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_FILE=/var/log/hydropi/daemon.log
LOG_LEVEL=INFO

# ── Development ───────────────────────────────────────────────────────────────
# Set to "true" to use simulated data instead of MySQL (for development/testing)
USE_MOCK=true
