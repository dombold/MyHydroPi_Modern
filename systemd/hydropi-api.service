[Unit]
Description=HydroPi FastAPI Web Server
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=exec
User=pi
Group=pi
WorkingDirectory=/home/pi/hydropi
EnvironmentFile=/home/pi/hydropi/.env
ExecStart=/home/pi/hydropi/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
